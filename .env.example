# --- required ---
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
COMPOSIO_API_KEY=

# --- Composio ---
# The Composio user id your YouTube / Instagram (/ Google Sheets) connections live under
COMPOSIO_USER_ID=default
# Optional: skip lookup of the Instagram business account id
IG_USER_ID=

# --- LLM (optional). Set => fresh topic + script every run. Unset => 4 built-in scripts rotate ---
ANTHROPIC_API_KEY=

# --- Voice ---
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Higgsfield video (optional). If set, used instead of Pexels (falls back to Pexels on failure) ---
# Either HF_API_KEY=<key_id>:<secret>  or  HF_API_KEY=<key_id> plus HF_API_SECRET=<secret>
HF_API_KEY=
HF_API_SECRET=
HF_MODEL=wan/v2.7/text-to-video
HF_MAX_CLIPS=6
# Extra JSON merged into the Higgsfield request body, e.g. {"resolution":"1080p"}
HF_EXTRA_JSON=

# --- Public hosting for the Reel (Instagram must fetch the MP4 from a public URL) ---
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://pub-xxxx.r2.dev or https://my-bucket.s3.eu-west-1.amazonaws.com
S3_PUBLIC_BASE_URL=
# Only for non-AWS providers (Cloudflare R2, Backblaze B2, MinIO...)
S3_ENDPOINT=

# --- Logging ---
# file (default): logs/runs.csv only.  composio: ALSO append to Google Sheets via Composio
LOG_MODE=file
SHEET_ID=
SHEET_NAME=
# Set to 1 only if Instagram shows "%23" in captions instead of #
IG_ENCODE_HASHTAGS=0

# --- Scheduling ---
# Scheduled runs wait a random 0..N minutes before starting (manual runs skip it). 0 disables.
MAX_START_DELAY_MIN=5
SKIP_DELAY=0
